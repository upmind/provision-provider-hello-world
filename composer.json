{
    "name": "upmind/provision-provider-hello-world",
    "description": "'Hello World' example of a Provision Category and Providers",
    "type": "library",
    "authors": [
        {
            "name": "Harry Lewis",
            "email": "harry@upmind.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Upmind\\ProvisionExample\\Category\\HelloWorld\\": "src/"
        }
    },
    "require": {
        "php": "^8.3",
        "upmind/provision-provider-base": "dev-feature/base-v5-support as 5.0.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^12.0 || ^13.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Upmind\\ProvisionExample\\Category\\HelloWorld\\Laravel\\ServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
